# ==============================================================================
# .env.example — Landing page dịch vụ B2B Mytel (+ Admin CMS-lite)
# Sao chép sang `.env` (dev) hoặc cấu hình biến môi trường ở UAT/prod.
# KHÔNG commit `.env` thật. Mọi secret placeholder — thay bằng giá trị thật khi deploy.
# Cấu hình theo 12-factor: app fail-fast nếu thiếu biến bắt buộc (xem src/lib/env.ts).
# ==============================================================================

# --- Cơ sở dữ liệu (PostgreSQL 17 — dùng chung cả on-prem lẫn UAT) --------------
# Prisma đọc DATABASE_URL. Prod on-prem: Postgres nội bộ. UAT: Postgres managed/tạm.
DATABASE_URL="postgresql://b2b_user:CHANGE_ME@localhost:5432/b2b?schema=public"

# --- Auth.js v5 (Admin) --------------------------------------------------------
# Sinh secret: `openssl rand -base64 32` (KHÔNG dùng giá trị placeholder ở prod).
AUTH_SECRET="CHANGE_ME_generate_a_32_byte_base64_secret"
# URL gốc ứng dụng (Auth.js callback). Dev: http://localhost:3000
AUTH_URL="http://localhost:3000"
# Bật tin cậy host phía sau reverse proxy (Nginx on-prem). true/false.
AUTH_TRUST_HOST="true"

# --- Seed tài khoản admin (chạy 1 lần qua `npm run db:seed`) --------------------
# Mật khẩu ≥12 ký tự (NFR-03), hash argon2id lúc seed. KHÔNG hardcode trong code.
SEED_ADMIN_EMAIL="admin@mytel.example"
SEED_ADMIN_PASSWORD="CHANGE_ME_min_12_chars"

# --- Adapter Email (cloud-agnostic: smtp | noop) -------------------------------
# on-prem = "smtp" (SMTP relay nội bộ Mytel, Nodemailer);
# UAT/dev = "noop" (không gửi thật, chỉ log — tránh lộ PII/không cần relay).
EMAIL_TRANSPORT="noop"
# Hộp thư Sale nhận thông báo lead (đích). [cần anh Bryan/DevOps cấp trước prod]
LEAD_NOTIFY_TO="sale@mytel.example"
LEAD_NOTIFY_FROM="no-reply@mytel.example"
# Cấu hình SMTP relay (chỉ dùng khi EMAIL_TRANSPORT=smtp).
SMTP_HOST="smtp-relay.mytel.internal"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""

# --- Adapter lưu file/asset (cloud-agnostic: local | noop) ---------------------
# on-prem = "local" (volume gắn kèm); UAT = "noop"/object-store sau này.
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage/uploads"

# --- Chống spam form (Cloudflare Turnstile) ------------------------------------
# Để trống ở dev → degrade (dựa honeypot + rate-limit). Điền khi bật Turnstile.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Nội dung consent PDPL -----------------------------------------------------
# Phiên bản văn bản consent hiển thị (do Legal/DPO duyệt — AS-07).
CONSENT_TEXT_VERSION="v1"

# --- Vận hành ------------------------------------------------------------------
# Số giây timezone nghiệp vụ hiển thị (UI đổi UTC → Asia/Yangon).
NEXT_PUBLIC_DISPLAY_TZ="Asia/Yangon"
